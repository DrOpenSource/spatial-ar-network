{
  "name": "spatial-ar-network",
  "private": true,
  "version": "1.0.0",
  "description": "Zero-install WebAR living landmarks & spatial ad network",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "sticker": "node tools/generate-sticker.mjs assets/targets/qutub-sticker.png --url https://spatial-ar-network.vercel.app",
    "target": "node tools/compile-target.mjs assets/targets/qutub-sticker.png public/targets/qutub.mind"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "patch-package": "^8.0.1",
    "qrcode": "^1.5.4",
    "vite": "^6.0.0"
  },
  "overrides": {
    "canvas": "^3.1.0"
  },
  "dependencies": {
    "3d-tiles-renderer": "^0.5.3",
    "mind-ar": "^1.2.5",
    "three": "^0.186.1"
  }
}
